@startuml Evaluation and Testing Sequence Diagram
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200

title Model Evaluation and Testing - Component Interactions and Data Flow

actor "NUbots Developer" as User
participant "CLI" as CLI
participant "Evaluation System" as Eval
participant "Trained Model\n(PPO/DDPG)" as Model
participant "SoccerEnv\n(Gymnasium)" as Env
participant "Visualisation\n(Pygame)" as Visual
participant "File System" as FS

== Initialisation Phase ==

User -> CLI: Execute evaluation command\n(model-path=path, model-type=PPO/DDPG,\n episodes=50, difficulty=medium)
activate CLI
activate Eval

CLI -> Eval: Initialise evaluation system

Eval -> FS: Load configurations and trained model\n(field_config.yaml, model.zip)
activate FS
FS --> Eval: Return configuration and model
deactivate FS

Eval -> Model: Load trained model
activate Model

Eval -> Env: Create evaluation environment\n(difficulty, field_config, render_mode)
activate Env
Env -> Env: Initialise field and physics parameters

opt Visualisation enabled
    Eval -> Visual: Initialise Pygame rendering
    activate Visual
end

== Evaluation Loop Phase ==

loop For each evaluation episode (n_episodes)
    Eval -> Env: Reset environment
    Env -> Env: Randomise initial positions
    Env --> Eval: Return observation (12D state)
    
    Eval -> Eval: Initialise episode metrics
    
    loop For each timestep in episode (until terminated or truncated)
        Eval -> Model: Get action for observation
        Model --> Eval: Return action (v_x, v_y, v_θ)
        
        Eval -> Env: Execute action
        Env -> Env: Update physics and calculate reward
        Env --> Eval: Return (observation, reward, terminated, truncated)
        
        Eval -> Eval: Update episode metrics
        
        opt Visualisation enabled
            Eval -> Visual: Render current state
        end
    end
    
    Eval -> Eval: Store episode results
end

opt Visualisation enabled
    Eval -> Visual: Close rendering
    deactivate Visual
end

deactivate Env
deactivate Model

== Analysis and Reporting Phase ==

Eval -> Eval: Calculate statistics\n(mean, std, success rate, possession %, collision frequency)

opt Comparison mode
    Eval -> Eval: Perform statistical tests\n(t-test, Cohen's d, p-values)
end

Eval -> Eval: Generate visualisation plots

Eval -> FS: Save results\n(metrics JSON, plots, summary report)
activate FS
deactivate FS

Eval --> CLI: Evaluation completed
deactivate Eval

CLI -> User: Display results summary
deactivate CLI

@enduml


